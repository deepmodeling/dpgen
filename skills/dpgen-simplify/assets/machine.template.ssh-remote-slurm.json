{
    "api_version": "1.0",
    "deepmd_version": "2.0",
    "train": {
        "command": "dp",
        "machine": {
            "batch_type": "Slurm",
            "context_type": "SSHContext",
            "local_root": "./",
            "remote_root": "/path/to/remote/work",
            "remote_profile": {
                "hostname": "cluster.example.com",
                "username": "REPLACE_ME",
                "port": 22,
                "key_filename": "/path/to/private/key"
